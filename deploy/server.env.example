# Copy to .env in the repository root on your server. Never commit the real .env.
# Bare public hostname only; do not include https://, a port, or a path.
APP_DOMAIN=decision.example.com
BASIC_AUTH_USER=owner

# Generate interactively (the plaintext password does not go into shell history):
# docker run --rm -it caddy:2.10-alpine caddy hash-password
# Paste the complete output hash between SINGLE quotes to preserve every $.
# Empty by default: Compose must refuse to start until you configure a password.
BASIC_AUTH_PASSWORD_HASH=''
